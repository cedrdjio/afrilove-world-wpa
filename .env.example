# AfroLove World — variables d'environnement
# Copiez ce fichier vers .env.local et renseignez vos clés.

# --- Supabase (client) ---
# URL du projet et clé publique (« anon / publishable ») — protégées par RLS.
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-cle-anon-publique"

# URL publique de l'app (SEO, manifeste, partages). En prod : votre domaine.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase (serveur uniquement — NE JAMAIS exposer au client) ---
# Utilisée par les scripts d'admin / migration de données. Optionnelle en dev.
SUPABASE_SERVICE_ROLE_KEY=""
